# Copy to .env and fill in. Never commit the filled-in version.

# Required ------------------------------------------------------------------

# The "company-A1B2C3" string from Settings -> Account Information.
# NOT your email -- that goes in BOOMI_USERNAME below. These two get swapped
# often enough that the scripts check for it and refuse to run.
BOOMI_ACCOUNT_ID=yourcompany-A1B2C3

# The email address you sign in to Boomi with.
# The BOOMI_TOKEN. prefix that Boomi's Basic auth expects is added by the
# scripts -- including it here causes a 401.
BOOMI_USERNAME=you@yourcompany.com

# Settings -> Platform API Tokens in the Boomi platform.
BOOMI_API_TOKEN=your-platform-api-token

# Safety --------------------------------------------------------------------

# Comma-separated environment names or IDs that migration refuses to write into.
# Enforced in the write path, and re-checked against the live environment record
# at apply time, so hand-editing a plan cannot get around it.
# Set this before your first migration.
BOOMI_PROTECTED_ENVIRONMENTS=Production

# Optional ------------------------------------------------------------------

# UK/GB accounts: https://api.platform.gb.boomi.com
# BOOMI_API_URL=https://api.boomi.com

# One-time passcode, if your account enforces MFA on API access.
# BOOMI_OTP=

# Extra comma-separated hints for identifying Event Streams connector
# components during the topology scan. Only needed if your account uses a
# connector identifier the defaults do not match.
# BOOMI_ES_CONNECTOR_TYPES=
